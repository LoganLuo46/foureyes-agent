DATABASE_URL=postgresql://foureyes:foureyes@localhost:5432/foureyes
# Read-only role, used only by mcp_lookup (ADR-002: the structural layer, enforced at the DB)
DATABASE_URL_RO=postgresql://foureyes_ro:foureyes_ro@localhost:5432/foureyes
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Region-sensitive: EU projects use cloud.langfuse.com, US projects use us.cloud.langfuse.com
# The wrong region returns 401 Invalid credentials — which is NOT an invalid key (see failures.md)
LANGFUSE_HOST=https://cloud.langfuse.com
REFUND_CAP_CENTS=50000
REFUND_WINDOW_DAYS=30
